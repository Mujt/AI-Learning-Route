        <mxGeometry x="10" y="180" width="144" height="34" as="geometry" />
      </mxCell>
        <mxCell id="7" value="模型将此视为一段未完成文本的开头，按照训练语料的统计规律续写。" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
        <mxGeometry x="10" y="210" width="792" height="34" as="geometry" />
      </mxCell>
        <mxCell id="8" value="输出方向完全由模型训练数据中的最常见后续决定，用户无控制权。" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
        <mxGeometry x="10" y="240" width="768" height="34" as="geometry" />
      </mxCell>
        <mxCell id="9" value="实际输出示例：" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
        <mxGeometry x="10" y="300" width="192" height="34" as="geometry" />
      </mxCell>
        <mxCell id="10" value="&quot;人工智能的未来将会非常美好，人类将与机器和谐共处，" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
        <mxGeometry x="10" y="330" width="660" height="34" as="geometry" />
      </mxCell>
        <mxCell id="11" value="共同创造一个前所未有的文明时代。在这个时代中，智能机器" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
        <mxGeometry x="10" y="360" width="708" height="34" as="geometry" />
      </mxCell>
        <mxCell id="12" value="将成为人类最忠实的伙伴...&quot;" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
