      </mxCell>
        <mxCell id="3" value="【无 Prompt（纯续写模式）】" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
        <mxGeometry x="10" y="60" width="324" height="34" as="geometry" />
