      </mxCell>
        <mxCell id="5" value="&quot;人工智能的未来&quot;" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
        <mxGeometry x="10" y="120" width="240" height="34" as="geometry" />
