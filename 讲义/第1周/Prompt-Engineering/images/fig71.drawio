        <mxCell id="5" value="══════════&amp;#xa;══════════&amp;#xa;ashiCorpV&amp;#xa;问题隔离）&amp;#xa;息）&amp;#xa;建议&amp;#xa;执行&amp;#xa;的1/30-1/&amp;#xa;│频率&amp;#xa;──────────&amp;#xa;│2-5次/周&amp;#xa;│20-50次/&amp;#xa;│无限制&amp;#xa;│数百次/天&amp;#xa;│10次/天&amp;#xa;──────────&amp;#xa;══════════" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
