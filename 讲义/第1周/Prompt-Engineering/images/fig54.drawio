      </mxCell>
        <mxCell id="6" value="1. 禁止在 Prompt 中硬编码 API Key / 密码 / 连接串" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
        <mxGeometry x="10" y="120" width="816" height="34" as="geometry" />
      </mxCell>
