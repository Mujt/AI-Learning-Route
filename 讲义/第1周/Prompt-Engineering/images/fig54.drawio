        <mxGeometry x="10" y="150" width="840" height="34" as="geometry" />
      </mxCell>
        <mxCell id="8" value="" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
        <mxGeometry x="10" y="180" width="804" height="34" as="geometry" />
      </mxCell>
        <mxCell id="9" value="2. 禁止在 Prompt 中粘贴完整客户数据" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
        <mxGeometry x="10" y="210" width="828" height="34" as="geometry" />
      </mxCell>
        <mxCell id="10" value="正确做法：脱敏处理，或在本地 RAG 管道中检索后注入" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
