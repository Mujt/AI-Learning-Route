        <mxCell id="2" value="【优化前】一次性抛出所有需求" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
        <mxGeometry x="10" y="0" width="336" height="34" as="geometry" />
      </mxCell>
        <mxCell id="3" value="Prompt: &quot;分析我们公司上季度的销售数据，找出问题，给出改善方案，" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
        <mxGeometry x="10" y="30" width="756" height="34" as="geometry" />
      </mxCell>
        <mxCell id="4" value="做成一页CEO摘要，还要有图表建议。&quot;" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
        <mxGeometry x="10" y="60" width="504" height="34" as="geometry" />
      </mxCell>
        <mxCell id="5" value="问题：模型可能遗漏某个子任务，或输出结构混乱。" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
        <mxGeometry x="10" y="120" width="552" height="34" as="geometry" />
      </mxCell>
        <mxCell id="6" value="───────────────────────────────────────────────────────────" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
        <mxGeometry x="10" y="180" width="708" height="34" as="geometry" />
      </mxCell>
        <mxCell id="7" value="【优化后】分3轮逐步推进" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
        <mxGeometry x="10" y="240" width="276" height="34" as="geometry" />
      </mxCell>
        <mxCell id="8" value="第1轮 Prompt:" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
        <mxGeometry x="10" y="300" width="156" height="34" as="geometry" />
      </mxCell>
        <mxCell id="9" value="&quot;首先，请分析上季度销售数据中的3个核心趋势和2个异常值。" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
        <mxGeometry x="10" y="330" width="684" height="34" as="geometry" />
      </mxCell>
        <mxCell id="10" value="数据如下：[粘贴数据]&quot;" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
        <mxGeometry x="10" y="360" width="288" height="34" as="geometry" />
      </mxCell>
        <mxCell id="11" value="第2轮 Prompt:" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
        <mxGeometry x="10" y="420" width="156" height="34" as="geometry" />
      </mxCell>
        <mxCell id="12" value="&quot;基于上述趋势和异常值，深入分析根本原因，" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
        <mxGeometry x="10" y="450" width="516" height="34" as="geometry" />
      </mxCell>
        <mxCell id="13" value="每个趋势和异常值各给出至少2个深层原因。&quot;" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
        <mxGeometry x="10" y="480" width="516" height="34" as="geometry" />
      </mxCell>
        <mxCell id="14" value="第3轮 Prompt:" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
        <mxGeometry x="10" y="540" width="156" height="34" as="geometry" />
      </mxCell>
        <mxCell id="15" value="&quot;将以上分析整理为一页CEO摘要：" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
        <mxGeometry x="10" y="570" width="384" height="34" as="geometry" />
      </mxCell>
        <mxCell id="16" value="格式——标题（10字）+3个核心发现（每项30字）+" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
        <mxGeometry x="10" y="600" width="552" height="34" as="geometry" />
      </mxCell>
        <mxCell id="17" value="风险信号（1条）+行动建议（3条，每条20字）。&quot;" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
        <mxGeometry x="10" y="630" width="564" height="34" as="geometry" />
      </mxCell>
        <mxCell id="18" value="效果：每步聚焦单一目标，输出质量显著提升，且便于在中途调整方向。" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" vertex="1" parent="1">
        <mxGeometry x="10" y="690" width="768" height="34" as="geometry" />
      </mxCell>
      </root>
