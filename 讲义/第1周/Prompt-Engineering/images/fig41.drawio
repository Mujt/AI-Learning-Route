        <mxCell id="3" value="────────────────────────&amp;#xa;模糊Task&amp;#xa;&quot;帮我分析这个方案&quot;&amp;#xa;────────────────────────&amp;#xa;&quot;写一篇关于AI的文章&quot;&amp;#xa;────────────────────────&amp;#xa;&quot;写一个用户登录功能&quot;&amp;#xa;────────────────────────&amp;#xa;&quot;分析这份销售数据&quot;&amp;#xa;────────────────────────&amp;#xa;&quot;做个PPT&quot;&amp;#xa;────────────────────────" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
